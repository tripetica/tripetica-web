{
  "name": "tripetica-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test lib/booking/pricing/*.test.ts lib/booking/fx/*.test.ts lib/booking/*.test.ts lib/db/*.test.ts lib/geo/*.test.ts lib/payments/*.test.ts lib/payments/ledger/*.test.ts lib/account/*.test.ts lib/mail/*.test.ts lib/alerts/*.test.ts lib/view/*.test.ts lib/uetds/*.test.ts lib/ops/push/*.test.ts lib/partner/*.test.ts lib/partner/push/*.test.ts lib/driver-portal/*.test.ts scripts/*.test.ts && tsx --conditions=react-server --test lib/payments/turinvoice/*.test.ts lib/server-tests/*.test.ts lib/seo/*.test.ts && tsx --conditions=react-server --test lib/ops/*.test.ts",
    "typecheck": "tsc --noEmit",
    "fx:refresh": "tsx --conditions=react-server scripts/refresh-fx-rates.ts",
    "fx:scheduled": "tsx --conditions=react-server scripts/fx-scheduled-refresh.ts",
    "mail:dispatch": "tsx --conditions=react-server scripts/send-pending-reservation-emails.ts",
    "partner:push:dispatch": "EXPECTED_DATABASE=tripetica_dev NODE_ENV=development tsx --conditions=react-server scripts/dispatch-partner-job-push.ts",
    "assignment-alarm:dispatch": "EXPECTED_DATABASE=tripetica_dev NODE_ENV=development tsx --conditions=react-server scripts/dispatch-assignment-alarms.ts",
    "flight-track:poll": "EXPECTED_DATABASE=tripetica_dev NODE_ENV=development tsx --conditions=react-server scripts/poll-flight-tracking.ts",
    "flight-track:poll:prod": "EXPECTED_DATABASE=tripetica NODE_ENV=production tsx --conditions=react-server scripts/poll-flight-tracking-prod.ts",
    "assignment-alarm:dispatch:prod": "EXPECTED_DATABASE=tripetica NODE_ENV=production tsx --conditions=react-server scripts/dispatch-assignment-alarms-prod.ts",
    "assignment-alarm:ring-once": "EXPECTED_DATABASE=tripetica_dev NODE_ENV=development ASSIGNMENT_ALARM_VOICE_ENABLED=true tsx --conditions=react-server scripts/dev-assignment-alarm-ring-once.ts",
    "payment-pending:expire": "tsx --conditions=react-server scripts/expire-stale-payment-pending.ts",
    "db:migrate:dev": "EXPECTED_DATABASE=tripetica_dev NODE_ENV=development tsx scripts/db-migrate.ts",
    "db:migrate:status:dev": "EXPECTED_DATABASE=tripetica_dev NODE_ENV=development tsx scripts/db-migrate.ts --status",
    "db:migrate:prod": "EXPECTED_DATABASE=tripetica NODE_ENV=production tsx scripts/db-migrate.ts",
    "db:migrate:status:prod": "EXPECTED_DATABASE=tripetica NODE_ENV=production tsx scripts/db-migrate.ts --status",
    "db:seed:dev": "EXPECTED_DATABASE=tripetica_dev NODE_ENV=development tsx scripts/seed-dev.ts",
    "ops:create-owner": "tsx --conditions=react-server scripts/create-ops-owner.ts",
    "ops:ensure-dev-owner": "EXPECTED_DATABASE=tripetica_dev NODE_ENV=development tsx --conditions=react-server scripts/ensure-dev-ops-owner.ts",
    "ops:set-password": "EXPECTED_DATABASE=tripetica_dev NODE_ENV=development tsx --conditions=react-server scripts/set-ops-user-password.ts",
    "partner:seed-dev": "EXPECTED_DATABASE=tripetica_dev NODE_ENV=development tsx --conditions=react-server scripts/seed-dev-partner.ts",
    "partner:set-password": "EXPECTED_DATABASE=tripetica_dev NODE_ENV=development tsx --conditions=react-server scripts/set-partner-user-password.ts"
  },
  "dependencies": {
    "arabic-persian-reshaper": "^1.0.1",
    "bidi-js": "^1.1.0",
    "libphonenumber-js": "^1.13.11",
    "next": "16.3.1",
    "nodemailer": "^9.1.0",
    "openai": "^7.20.0",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
