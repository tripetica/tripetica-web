[Unit]
Description=Tripetica production FX refresh and reservation/operation email dispatch
After=network-online.target postgresql.service
Wants=postgresql.service network-online.target

[Service]
Type=oneshot
User=tripetica-worker
Group=tripetica-worker
WorkingDirectory=/srv/tripetica/current
ExecStartPre=/usr/local/lib/tripetica/assert-expected-database /srv/tripetica/current/.env.production.local
ExecStart=/usr/bin/npm run fx:scheduled
TimeoutStartSec=120
Nice=10
UMask=0077
Environment=PATH=/usr/bin:/usr/local/bin
Environment=HOME=/var/lib/tripetica-worker
Environment=npm_config_cache=/var/lib/tripetica-worker/npm-cache
Environment=NODE_ENV=production
Environment=EXPECTED_DATABASE=tripetica
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateDevices=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadWritePaths=/var/lib/tripetica-worker
InaccessiblePaths=/root/tripetica-web
BindReadOnlyPaths=/srv/tripetica/current/.env.production.local:/srv/tripetica/current/.env.local
StandardOutput=journal
StandardError=journal
