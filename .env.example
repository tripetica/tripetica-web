# Server-only. Do not prefix with NEXT_PUBLIC_.
# Enable Places API (New): Autocomplete and Place Details.
# Optional: enable Maps Static API on this key (or GOOGLE_MAPS_API_KEY) to
# render Google tiles for the desktop booking route map. Until that API is
# allowed on the key, the map uses OpenStreetMap tiles with the selected
# A/B points and the real driving polyline.
# Server-side Static Maps requests need IP (or unrestricted app) access,
# not only HTTP referrer restrictions.
# Fallback name also supported: GOOGLE_MAPS_API_KEY
GOOGLE_PLACES_API_KEY=

# Public site key for checkout Google reCAPTCHA (cash payment only).
# Currently used for /tr, /en, and /ru. Yandex SmartCaptcha keys remain for a
# later /ru switch and are unused in this phase.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_YANDEX_SMARTCAPTCHA_CLIENT_KEY=
YANDEX_SMARTCAPTCHA_CLIENT_KEY=

# Server secrets for later token verification. Not used until reservation submit.
RECAPTCHA_SECRET_KEY=
YANDEX_SMARTCAPTCHA_SERVER_KEY=

# Twilio outbound emergency reservation ring (server-only). Real calls stay
# off unless TWILIO_VOICE_ALERTS_ENABLED=true. TWILIO_API_KEY is an accepted
# alias for TWILIO_API_KEY_SID.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_SECRET=
# TWILIO_FROM_NUMBER=
# TWILIO_ALERT_TO_NUMBER=
TWILIO_VOICE_ALERTS_ENABLED=false

# Assignment-missing reminders (DEV-only until production cutover).
# Without ASSIGNMENT_ALARM_EMAIL_TO, DEV records a dry-run and does not mail
# operation@tripetica.com. Voice is ring-only Hangup TwiML (no TTS/SMS).
# Real calls stay off unless ASSIGNMENT_ALARM_VOICE_ENABLED=true; they use
# TWILIO_ALERT_TO_NUMBER. Keep this false on the DEV timer.
# ASSIGNMENT_ALARM_EMAIL_TO=
# ASSIGNMENT_ALARM_VOICE_ENABLED=false

# Public app origin used for Turinvoice callbackUrl / redirectUrl (no trailing slash).
# Dev while testing LIVE payments: https://dev.tripetica.com
# Production later: https://tripetica.com
APP_BASE_URL=

# Customer account outbound email (Namecheap Private Email SMTP).
# Required for real verification delivery. Do not invent credentials.
# ACCOUNT_EMAIL_PROVIDER=smtp
# ACCOUNT_EMAIL_FROM=Tripetica <noreply@tripetica.com>

# Reservation confirmation + payment confirmation emails (separate SMTP mailbox).
# RESERVATION_EMAIL_FROM=Tripetica | Reservation <reservation@tripetica.com>
# RESERVATION_SMTP_HOST=mail.privateemail.com
# RESERVATION_SMTP_PORT=465
# RESERVATION_SMTP_SECURE=true
# RESERVATION_SMTP_USER=
# RESERVATION_SMTP_PASS=

# Shared account SMTP (Namecheap Private Email). Used by account verification mail only.
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=

# Active Turinvoice credential set: test | live (default live).
TURINVOICE_ENV=live

# Turinvoice SBP / QR (server-only; never NEXT_PUBLIC_).
# Keep both sets; only TURINVOICE_ENV selects which is used at runtime.
TURINVOICE_TEST_BASE_URL=
TURINVOICE_TEST_LOGIN=
TURINVOICE_TEST_PASSWORD=
TURINVOICE_TEST_TSP_ID=
TURINVOICE_TEST_CALLBACK_SECRET=

TURINVOICE_LIVE_BASE_URL=
TURINVOICE_LIVE_LOGIN=
TURINVOICE_LIVE_PASSWORD=
TURINVOICE_LIVE_TSP_ID=
TURINVOICE_LIVE_CALLBACK_SECRET=

# Ops Web Push (VAPID). Server-only. Generate with:
# npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:operation@tripetica.com

# AES-256-GCM key for U-ETDS TEST/LIVE passwords stored in uetds_companies.
# 32-byte hex (64 chars) or base64. Server-only. Never NEXT_PUBLIC_.
# UETDS_CREDENTIALS_KEY=

# DEV: comma-separated ministry UNET / live_username values that use Kamu portal
# in-place passenger update (default 1046786 = SEARCH TRAVEL). Not short_name.
# UETDS_KAMU_PASSENGER_UPDATE_UNET_IDS=1046786
# DEV: sealed Kamu browser Cookie jar path (never commit; never log contents).
# UETDS_KAMU_SESSION_PATH=tmp/uetds-kamu-session.sealed

# Optional payment details for future U-ETDS driver-subscription reminder emails.
# Not wired to a timer yet — claim table + copy builders exist; no send loop.
# UETDS_SUBSCRIPTION_PAYMENT_IBAN=
# UETDS_SUBSCRIPTION_PAYMENT_BENEFICIARY=
# UETDS_SUBSCRIPTION_PAYMENT_NOTE=


