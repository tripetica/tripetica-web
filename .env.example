# Server-only. Do not prefix with NEXT_PUBLIC_.
# Enable Places API (New): Autocomplete and Place Details.
# Optional: enable Maps Static API on this key (or GOOGLE_MAPS_API_KEY) to
# render Google tiles for the desktop booking route map. Until that API is
# allowed on the key, the map uses OpenStreetMap tiles with the selected
# A/B points and the real driving polyline.
# Server-side Static Maps requests need IP (or unrestricted app) access,
# not only HTTP referrer restrictions.
# Fallback name also supported: GOOGLE_MAPS_API_KEY
GOOGLE_PLACES_API_KEY=

# Public site key for checkout Google reCAPTCHA (cash payment only).
# Currently used for /tr, /en, and /ru. Yandex SmartCaptcha keys remain for a
# later /ru switch and are unused in this phase.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_YANDEX_SMARTCAPTCHA_CLIENT_KEY=
YANDEX_SMARTCAPTCHA_CLIENT_KEY=

# Server secrets for later token verification. Not used until reservation submit.
RECAPTCHA_SECRET_KEY=
YANDEX_SMARTCAPTCHA_SERVER_KEY=

